NEXUS_JWT_REFRESH_SECRET=

MEDI_DB_PASSWORD=
MEDI_JWT_ACCESS_SECRET=
MEDI_DATA_ENCRYPTION_KEY=

# Optional SMTP for MediConsult emails (leave as-is to disable)
