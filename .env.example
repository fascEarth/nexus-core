# Copy to apps/api/.env
# Owner connection (migrations, seed). Bypasses RLS.
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
# Application connection (restricted role, RLS enforced). Created by prisma/rls.sql
APP_DATABASE_URL=postgresql://nexus_app:nexus_app@localhost:5432/nexus
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14

PORT=3000
CORS_ORIGINS=http://localhost:4200
# Tenant resolution: header X-Tenant, subdomain, or JWT claim
ROOT_DOMAIN=localhost

# AI layer (Phase 4)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
